{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prismpm/library-verification-manifest/1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "acceptance_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "byte_length": {
            "type": "integer",
            "minimum": 0
          },
          "path": {
            "type": "string",
            "pattern": "^library/[A-Za-z0-9_./-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "byte_length",
          "path",
          "sha256"
        ]
      }
    },
    "build_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lexlean_attestation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "processes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "executable_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "exit_code": {
            "const": 0
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          }
        },
        "required": [
          "tool",
          "argv",
          "executable_sha256",
          "exit_code",
          "stdout",
          "stderr"
        ]
      }
    },
    "schema": {
      "const": "prismpm/library-verification-manifest/1"
    },
    "scope": {
      "const": "native-library-only"
    }
  },
  "required": [
    "acceptance_sha256",
    "artifacts",
    "build_id",
    "lexlean_attestation_sha256",
    "model_sha256",
    "processes",
    "schema",
    "scope"
  ]
}
