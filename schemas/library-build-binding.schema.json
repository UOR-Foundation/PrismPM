{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prismpm/library-build-binding/1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "acceptance_roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 1024
      }
    },
    "export_roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 1024
      }
    },
    "model_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile": {
      "const": "prismpm/native-library/1"
    },
    "schema": {
      "const": "prismpm/library-build-binding/1"
    },
    "scope": {
      "const": "native-library-only"
    }
  },
  "required": [
    "acceptance_roots",
    "export_roots",
    "model_id",
    "profile",
    "schema",
    "scope"
  ]
}
