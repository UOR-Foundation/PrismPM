{
  "$id": "https://schemas.uor.foundation/prismpm/browser-system-release/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "prismpm/browser-system-release/1"
    },
    "system_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "application_model_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "component": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,127}$"
    },
    "artifact": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,127}$"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,127}$"
    },
    "controls": {
      "const": [
        "application-acceptance",
        "artifact-closure",
        "source-proof",
        "spdx"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 7,
      "maxItems": 65536,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 536870912
          }
        },
        "required": [
          "path",
          "digest",
          "size"
        ]
      }
    }
  },
  "required": [
    "schema",
    "system_digest",
    "application_model_digest",
    "component",
    "artifact",
    "target",
    "controls",
    "files"
  ]
}
