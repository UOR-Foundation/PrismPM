  "$defs": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "prismpm/text-application/4"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_. -]*[A-Za-z0-9_-])?$"
        },
        "cargo_name": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "type": "string"
        },
        "cargo_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "cargo_description": {
          "minLength": 1,
          "type": "string"
        },
        "cargo_repository": {
          "format": "uri",
          "pattern": "^https://",
          "type": "string"
        },
        "cargo_homepage": {
          "format": "uri",
          "pattern": "^https://",
          "type": "string"
        },
        "library_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
          }
        },
        "acceptance_vectors": {
          "items": {
            "$ref": "#/$defs/application_acceptance_vector"
          },
          "minItems": 1,
          "type": "array"
        },
        "entry_root": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
        },
        "core_contract": {
          "const": "hologram:guest/core-wasm@1"
        },
        "request_maximum": {
          "maximum": 2097152,
          "minimum": 1,
          "type": "integer"
        },
        "response_maximum": {
          "maximum": 4194304,
          "minimum": 1,
          "type": "integer"
        },
        "guest_allocation_maximum": {
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        "capabilities_empty": {
          "const": true
        },
        "fat_archive": {
          "const": true
        },
        "primary_layer": {
          "const": 0
        },
        "view_layer": {
          "const": 1
        },
        "view": {
          "$ref": "#/$defs/WorkbenchView"
        },
        "core_memory_pages": {
          "maximum": 32767,
          "minimum": 1,
          "type": "integer"
        },
        "core_stack_bytes": {
          "maximum": 4294967295,
          "minimum": 16,
          "multipleOf": 16,
          "type": "integer"
        }
      },
      "required": [
        "acceptance_vectors",
        "capabilities_empty",
        "cargo_description",
        "cargo_homepage",
        "cargo_name",
        "cargo_repository",
        "cargo_version",
        "core_contract",
        "core_memory_pages",
        "core_stack_bytes",
        "entry_root",
        "fat_archive",
        "guest_allocation_maximum",
        "library_roots",
        "name",
        "primary_layer",
        "profile",
        "request_maximum",
        "response_maximum",
        "view",
        "view_layer"
      ]
    },
    "application_acceptance_vector": {
      "additionalProperties": false,
      "properties": {
        "request": {
          "items": {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "response": {
          "items": {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "request",
        "response"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "compiler_semantics_id": {
          "$ref": "#/$defs/sha256"
        },
        "emitter_semantics_id": {
          "$ref": "#/$defs/sha256"
        },
        "facet_packages": {
          "const": []
        },
        "semantic_id": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_id": {
          "$ref": "#/$defs/sha256"
        },
        "source_id": {
          "$ref": "#/$defs/sha256"
        }
