{
  "$id": "prismpm/model-document/7",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BoundedServerHostEffectModelDocument",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "application": {
      "$ref": "#/$defs/application"
    },
    "architecture": {
      "const": {
        "component_kinds": [],
        "components": [],
        "concerns": [],
        "edge_kinds": [],
        "edges": [],
        "model_kinds": [],
        "stakeholders": [],
        "viewpoints": [],
        "views": []
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "quality": {
      "const": {
        "characteristics": [],
        "measures": [],
        "requirements": [],
        "subcharacteristics": []
      }
    },
    "schema": {
      "const": "prismpm/model-document/7"
    },
    "security": {
      "const": {
        "activities": [],
        "assets": [],
        "controls": [],
        "impacts": [],
        "likelihoods": [],
        "measurements": [],
        "risks": [],
        "threats": []
      }
    },
    "standards_profile": {
      "const": []
    }
  },
  "required": [
    "application",
    "architecture",
    "provenance",
    "quality",
    "schema",
    "security",
    "standards_profile"
  ],
  "$defs": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "prismpm/server-application/1"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_. -]*[A-Za-z0-9_-])?$"
        },
        "cargo_name": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "type": "string"
        },
        "cargo_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "cargo_description": {
          "minLength": 1,
          "type": "string"
        },
        "cargo_repository": {
          "format": "uri",
          "pattern": "^https://",
          "type": "string"
        },
        "cargo_homepage": {
          "format": "uri",
          "pattern": "^https://",
          "type": "string"
        },
        "core": {
          "$ref": "#/$defs/server_core"
        },
        "acceptance_vectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/application_acceptance_vector"
          }
        },
        "request_maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "response_maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "bindings": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/server_binding"
          }
        },
        "host": {
          "$ref": "#/$defs/host_protocol"
        }
      },
      "required": [
        "acceptance_vectors",
        "bindings",
        "cargo_description",
        "cargo_homepage",
        "cargo_name",
        "cargo_repository",
        "cargo_version",
        "core",
        "host",
        "name",
        "profile",
        "request_maximum",
        "response_maximum"
      ]
    },
    "server_core": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
        },
        "package": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "package",
        "root",
        "version"
      ]
    },
    "server_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "crate_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "host": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)+$"
        }
      },
      "required": [
        "crate_name",
        "host",
        "version"
      ]
    },
    "application_acceptance_vector": {
      "additionalProperties": false,
      "properties": {
        "request": {
          "items": {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "response": {
          "items": {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "request",
        "response"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "compiler_semantics_id": {
          "$ref": "#/$defs/sha256"
        },
        "emitter_semantics_id": {
          "$ref": "#/$defs/sha256"
        },
        "facet_packages": {
          "const": []
        },
        "semantic_id": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_id": {
          "$ref": "#/$defs/sha256"
        },
        "source_id": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "compiler_semantics_id",
        "emitter_semantics_id",
        "facet_packages",
        "semantic_id",
        "snapshot_id",
        "source_id"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "host_protocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "prismpm/host-effects/1"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f]+$"
        },
        "usage_code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 125
        },
        "io_code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 125
        },
        "fault_code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 125
        },
        "effect_budget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "effects": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/host_effect"
          }
        },
        "transcripts": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/host_transcript"
          }
        }
      },
      "required": [
        "description",
        "effect_budget",
        "effects",
        "fault_code",
        "io_code",
        "protocol",
        "transcripts",
        "usage_code"
      ]
    },
    "host_effect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)*$"
        },
        "request": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/host_field"
          }
        },
        "result": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/host_field"
          }
        },
        "failures": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z][a-z0-9]*)*$"
          }
        },
        "request_maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "result_maximum": {
          "type": "integer",
          "minimum": 4,
          "maximum": 16777216
        }
      },
      "required": [
        "failures",
        "name",
        "request",
        "request_maximum",
        "result",
        "result_maximum"
      ]
    },
    "host_field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "kind": {
          "enum": [
            "u32",
            "u64",
            "flag",
            "bytes",
            "text"
          ]
        }
      },
      "required": [
        "kind",
        "name"
      ]
    },
    "host_transcript": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vector": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/host_step"
          }
        }
      },
      "required": [
        "steps",
        "vector"
      ]
    },
    "host_step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "effect": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)*$"
        },
        "request": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "outcome": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      },
      "required": [
        "effect",
        "outcome",
        "request"
      ]
    }
  }
}
