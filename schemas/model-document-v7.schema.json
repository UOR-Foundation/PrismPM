{
  "$id": "prismpm/model-document/7",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchWorkbenchModelDocument",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "application": {
      "$ref": "#/$defs/application"
    },
    "architecture": {
      "const": {
        "component_kinds": [],
        "components": [],
        "concerns": [],
        "edge_kinds": [],
        "edges": [],
        "model_kinds": [],
        "stakeholders": [],
        "viewpoints": [],
        "views": []
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "quality": {
      "const": {
        "characteristics": [],
        "measures": [],
        "requirements": [],
        "subcharacteristics": []
      }
    },
    "schema": {
      "const": "prismpm/model-document/7"
    },
    "security": {
      "const": {
        "activities": [],
        "assets": [],
        "controls": [],
        "impacts": [],
        "likelihoods": [],
        "measurements": [],
        "risks": [],
        "threats": []
      }
