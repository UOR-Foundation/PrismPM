{
  "$id": "https://schemas.uor.foundation/prismpm/browser-export/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrismPM browser export integrity receipt; not publication authorization",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "properties": {
    "schema": {"const": "prismpm/browser-export/1"},
    "reference": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[a-z0-9.-]+(?::[0-9]+)?/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$"
    },
    "release_digest": {"$ref": "#/$defs/digest"},
    "model_digest": {"$ref": "#/$defs/digest"},
    "build_digest": {"$ref": "#/$defs/digest"},
    "tree_digest": {"$ref": "#/$defs/digest"},
    "output": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "files": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"},
          "digest": {"$ref": "#/$defs/digest"},
          "size": {"type": "integer", "minimum": 0, "maximum": 10737418240}
        },
        "required": ["path", "digest", "size"]
      }
    }
  },
  "required": ["schema", "reference", "release_digest", "model_digest", "build_digest", "tree_digest", "output", "files"]
}
