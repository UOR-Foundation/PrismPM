 pub const MAX_INTENT_OUTPUTS: usize = 16;
 pub const MAX_INTENT_OUTPUT_BYTES: usize = 1024 * 1024;
 
+/// Immutable limits selected by a trusted host before starting a session.
+/// Defaults preserve the original portable View protocol. Guest payloads cannot
+/// select or enlarge these limits. Byte counts are UTF-8, not character counts.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct ViewIntentLimits {
+    payload_bytes: usize,
+    output_bytes: usize,
+}
+
+impl ViewIntentLimits {
+    pub fn new(payload_bytes: usize, output_bytes: usize) -> Result<Self, String> {
+        for value in [payload_bytes, output_bytes] {
+            if value == 0
+                || value
+                    .checked_mul(6)
+                    .and_then(|n| n.checked_add(256))
+                    .is_none()
+            {
+                return Err(
+                    "portable View limits must be positive with representable JSON envelopes"
+                        .to_owned(),
+                );
+            }
+        }
+        Ok(Self {
+            payload_bytes,
+            output_bytes,
+        })
+    }
+
+    pub const fn payload_bytes(self) -> usize {
+        self.payload_bytes
+    }
+    pub const fn output_bytes(self) -> usize {
+        self.output_bytes
+    }
+    pub const fn request_envelope_bytes(self) -> usize {
+        self.payload_bytes * 6 + 256
+    }
+}
+
+impl Default for ViewIntentLimits {
+    fn default() -> Self {
+        Self {
+            payload_bytes: MAX_INTENT_PAYLOAD_BYTES,
+            output_bytes: MAX_INTENT_OUTPUT_BYTES,
+        }
+    }
+}
