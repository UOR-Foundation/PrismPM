; Internal canonical definite-array CBOR. Semantic guards are in Custody.lex.tex.
uint32 = 0..4294967295
reference = bstr .size 32
name = tstr .size (1..128)
resource = [name, name, name, 1..1048576]
policy = [reference, reference, [1*64 name], [1*64 resource]]
binding = [reference, reference, name, bstr .size 65, tstr .size 71]
snapshot = [policy, [1*64 binding]]
authorization = [name, name, name, 1..1048576, bstr .size 65, tstr .size 71]
optional-snapshot = [0] / [1, snapshot]
request = [1, 0, policy]
        / [1, 1, policy, optional-snapshot, [0*64 binding]]
        / [1, 2, policy, optional-snapshot]
        / [1, 3, snapshot, reference, reference, name, bstr .size (0..1048576)]
reply = [0, policy] / [1, snapshot] / [2, authorization]
response = [1, 0, reply] / [1, 1, [0..7]] / [1, 2, 0..8]
