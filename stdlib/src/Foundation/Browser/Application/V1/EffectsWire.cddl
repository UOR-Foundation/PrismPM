; Internal closed ABI. Additional exact limits are enforced by the model.
u32 = 0..4294967295
ref = bstr .size 32
guest-bytes = bstr .size (0..2097152)
primitive-bytes = bstr .size (0..1048576)
optional-ref = [0] / [1, tstr]
limits = [input: u32, output: u32, memory-pages: u32]
guest = [artifact: ref, entry: tstr, protocol: tstr, input: u32, output: u32, memory-pages: u32]
signing = [public-key: bstr .size 65, context: tstr]
storage = [namespace: tstr, object-bytes: u32, objects: u32, heads: u32]
adapter = [0, guest] / [1] / [2] / [3, signing] / [4, signing] / [5, storage]
grant = [resource: tstr, adapter]
manifest = [application: ref, manifest-id: ref, limits, [1*64 grant]]
invocation = [artifact: ref, entry: tstr, protocol: tstr, input: guest-bytes]
verification = [value: primitive-bytes, signature: bstr .size 64]
commit = [head: tstr, expected: optional-ref, next: tstr, [*16 primitive-bytes]]
operation = [0, invocation] / [1, u32] / [2, primitive-bytes] / [3, primitive-bytes] / [4, verification] / [5, tstr] / [6, tstr] / [7, commit]
request = [application: ref, manifest-id: ref, session: ref, operation-id: u32, resource: tstr, operation]
optional-request = [0] / [1, request]
head = [id: tstr, bytes: primitive-bytes]
result = [0, guest-bytes] / [1, bstr .size (0..65536)] / [2, tstr] / [3, bstr .size 64] / [4, bool] / [5, [0] / [1, primitive-bytes]] / [6, [0] / [1, head]] / [7, tstr] / [8, [0..12]] / [9]
completion = [request, result]
state = [manifest, session: ref, next-operation: u32, closed: bool, uncertain: bool, active: optional-request, waiter: optional-request]
input = [1, 0, manifest, session: ref] / [1, 1, state, request] / [1, 2, state, completion] / [1, 3, state]
output = [1, 0, state] / [1, 1, [0..14]] / [1, 2, 0..8]
