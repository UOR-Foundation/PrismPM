{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.uor.foundation/prismpm/browser-provenance/2",
  "title": "BrowserProvenance",
  "description": "provenance.json in the closure v2 browser export that prismpm export-browser writes (crates/prismpm/src/application_build.rs): every v1 field plus the SHA-256 of every other closure file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_lock_sha256",
    "adapter_wasm_sha256",
    "binding_javascript_sha256",
    "files",
    "generated_core_sha256",
    "model_id",
    "schema",
    "view_manifest_sha256",
    "view_model_id"
  ],
  "properties": {
    "adapter_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adapter_wasm_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "binding_javascript_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "object",
      "description": "Every closure file except provenance.json, by file name, to its lowercase hex SHA-256.",
      "minProperties": 5,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "generated_core_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema": {
      "const": "prismpm/browser-provenance/2"
    },
    "view_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "view_model_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
