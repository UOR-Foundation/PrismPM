{
  "schema": "prism/conformance-scenario/1",
  "id": "replay-divergence",
  "feature": "replay",
  "cites": [
    "HO-29",
    "HO-31"
  ],
  "revision": "2026-10-23",
  "archive": "fixtures/negative/Calculator.changed-model.holo",
  "statement": "A changed model that passes its own vectors diverges on the recorded history: exit 1, every divergence reported with its index, request, expected and actual outcome, and the statement records the count.",
  "steps": [
    {
      "action": "vectors",
      "archive": "fixtures/negative/Calculator.changed-model.holo",
      "expect": {
        "exit": 0,
        "result": {
          "failed": 0,
          "total": {
            "$min": 1
          }
        }
      }
    },
    {
      "action": "replay",
      "archive": "fixtures/negative/Calculator.changed-model.holo",
      "histories": [
        "fixtures/Calculator.history.json"
      ],
      "expect": {
        "exit": 1,
        "result": {
          "schema": "prismpm/replay-result/1",
          "divergenceCount": {
            "$min": 1
          },
          "histories": [
            {
              "divergences": {
                "$length": {
                  "$min": 1
                },
                "$some": {
                  "index": {
                    "$type": "number",
                    "$min": 0
                  },
                  "request": {
                    "$regex": "^([0-9a-f]{2})*$"
                  },
                  "expected": {
                    "$type": "object"
                  },
                  "actual": {
                    "$type": "object"
                  }
                }
              }
            }
          ],
          "statement": {
            "predicateType": "https://uor.foundation/prism/replay/v1",
            "predicate": {
              "divergenceCount": {
                "$min": 1
              }
            }
          }
        }
      }
    }
  ]
}
