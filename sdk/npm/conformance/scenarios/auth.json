{
  "feature": "auth",
  "title": "Registry logins and signing identities",
  "checks": [
    {
      "id": "auth.login.docker-config-entry",
      "title": "A login with no helper configured writes the entry Docker writes.",
      "op": "auth",
      "input": { "call": "login", "request": { "username": "test-user", "password": "test-password", "registry": "registry.test" } },
      "expect": {
        "ok": true,
        "result": {
          "value": { "registry": "registry.test", "username": "test-user", "store": { "kind": "config" }, "verified": false },
          "config": { "auths": { "registry.test": { "auth": "dGVzdC11c2VyOnRlc3QtcGFzc3dvcmQ=" } } }
        }
      }
    },
    {
      "id": "auth.login.keeps-the-config",
      "title": "A login keeps everything else in the config and replaces older spellings of the registry.",
      "op": "auth",
      "input": {
        "call": "login",
        "config": { "HttpHeaders": { "X-Test": "1" }, "auths": { "https://registry.test": { "auth": "b2xkOm9sZA==" } } },
        "request": { "username": "test-user", "password": "test-password", "registry": "registry.test" }
      },
      "expect": {
        "ok": true,
        "result": {
          "config": { "HttpHeaders": { "X-Test": "1" }, "auths": { "registry.test": { "auth": "dGVzdC11c2VyOnRlc3QtcGFzc3dvcmQ=" }, "https://registry.test": { "$absent": true } } }
        }
      }
    },
    {
      "id": "auth.login.docker-hub-by-default",
      "title": "A login that names no registry is to Docker Hub, under Docker's key.",
      "op": "auth",
      "input": { "call": "login", "request": { "username": "test-user", "password": "test-password" } },
      "expect": {
        "ok": true,
        "result": {
          "value": { "registry": "docker.io" },
          "config": { "auths": { "https://index.docker.io/v1/": { "auth": "dGVzdC11c2VyOnRlc3QtcGFzc3dvcmQ=" } } }
        }
      }
    },
    {
      "id": "auth.login.username-with-colon",
      "title": "A username with a colon is refused: Docker's entry could not be read back.",
      "op": "auth",
      "input": { "call": "login", "request": { "username": "with:colon", "password": "test-password", "registry": "registry.test" } },
      "expect": { "ok": false, "error": { "code": "registry_failed", "check": "store.credential-input" } }
    },
    {
      "id": "auth.login.registry-with-a-scheme",
      "title": "A registry is a host name, not a URL.",
      "op": "auth",
      "input": { "call": "login", "request": { "username": "test-user", "password": "test-password", "registry": "https://registry.test" } },
      "expect": { "ok": false, "error": { "code": "registry_failed", "check": "store.credential-input" } }
    },
    {
      "id": "auth.login.config-not-json",
      "title": "A config that does not parse is refused, not overwritten.",
      "op": "auth",
      "input": { "call": "login", "config": "{ not json", "request": { "username": "test-user", "password": "test-password", "registry": "registry.test" } },
      "expect": { "ok": false, "error": { "code": "registry_failed", "check": "store.credentials" } }
    },
    {
      "id": "auth.login.helper-not-installed",
      "title": "A login that a configured helper cannot store fails: it never appears to work.",
      "op": "auth",
      "input": { "call": "login", "config": { "credsStore": "prism-no-such-helper" }, "request": { "username": "test-user", "password": "test-password", "registry": "registry.test" } },
      "expect": { "ok": false, "error": { "code": "registry_failed", "check": "store.credentials" } }
    },
    {
      "id": "auth.logout.removes-every-spelling",
      "title": "A logout removes the registry under every key Docker may file it by, and leaves the others.",
      "op": "auth",
      "input": {
        "call": "logout",
        "config": { "auths": { "registry.test": { "auth": "b2xkOm9sZA==" }, "https://registry.test/v1/": { "auth": "b2xkOm9sZA==" }, "other.test": { "auth": "b2xkOm9sZA==" } } },
        "request": { "registry": "registry.test" }
      },
      "expect": {
        "ok": true,
        "result": {
          "value": { "registry": "registry.test", "removed": true, "ambient": null },
          "config": { "auths": { "registry.test": { "$absent": true }, "https://registry.test/v1/": { "$absent": true }, "other.test": { "auth": "b2xkOm9sZA==" } } }
        }
      }
    },
    {
      "id": "auth.logout.nothing-there",
      "title": "A logout with nothing to remove says so and is not an error.",
      "op": "auth",
      "input": { "call": "logout", "request": { "registry": "registry.test" } },
      "expect": { "ok": true, "result": { "value": { "registry": "registry.test", "removed": false, "ambient": null } } }
    },
    {
      "id": "auth.logout.names-the-ambient-token",
      "title": "A logout says which variable still gives ghcr.io a token, because it cannot clear one.",
      "op": "auth",
      "input": { "call": "logout", "env": { "GHCR_TOKEN": "test-ambient-token" }, "request": { "registry": "ghcr.io" } },
      "expect": { "ok": true, "result": { "value": { "registry": "ghcr.io", "removed": false, "ambient": "GHCR_TOKEN" } } }
    },
    {
      "id": "auth.inspect.password",
      "title": "Inspect reports a password credential's type, username and store.",
      "op": "auth",
      "input": { "call": "inspect", "config": { "auths": { "registry.test": { "auth": "dGVzdC11c2VyOnRlc3QtcGFzc3dvcmQ=" } } }, "registry": "registry.test" },
      "expect": { "ok": true, "result": { "value": { "registry": "registry.test", "type": "password", "username": "test-user", "store": { "kind": "config" }, "password": { "$absent": true } } } }
    },
    {
      "id": "auth.inspect.identity-token",
      "title": "Inspect reports an identity token by its type alone.",
      "op": "auth",
      "input": { "call": "inspect", "config": { "auths": { "registry.test": { "identitytoken": "test-identity-token" } } }, "registry": "registry.test" },
      "expect": { "ok": true, "result": { "value": { "type": "identity-token", "username": null, "identityToken": { "$absent": true } } } }
    },
    {
      "id": "auth.inspect.nothing-there",
      "title": "Inspect of a registry with no credential is null.",
      "op": "auth",
      "input": { "call": "inspect", "registry": "registry.test" },
      "expect": { "ok": true, "result": { "value": null } }
    },
    {
      "id": "auth.stores.helper-for-a-registry",
      "title": "A login goes to the registry's helper before the default one, and to the config when there is neither.",
      "op": "auth",
      "input": { "call": "stores.get", "config": { "credHelpers": { "registry.test": "prism-scoped" }, "credsStore": "prism-default" }, "registry": "registry.test" },
      "expect": { "ok": true, "result": { "value": { "kind": "helper", "name": "prism-scoped" } } }
    },
    {
      "id": "auth.identities.unreadable-key",
      "title": "A signing key that cannot be read is a signing error about the key.",
      "op": "auth",
      "input": { "call": "identities.fromKey", "key": "test-not-a-key" },
      "expect": { "ok": false, "error": { "code": "signing_failed", "check": "sign.key" } }
    },
    {
      "id": "auth.identities.empty-token",
      "title": "An empty identity token is a signing error about the identity.",
      "op": "auth",
      "input": { "call": "identities.keyless", "identityToken": "" },
      "expect": { "ok": false, "error": { "code": "signing_failed", "check": "sign.identity" } }
    }
  ]
}
