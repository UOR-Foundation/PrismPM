{
  "schema": "prism/conformance-scenario/1",
  "id": "check-minimum-p0",
  "feature": "check",
  "cites": [
    "HO-31"
  ],
  "revision": "2026-10-23",
  "archive": "each",
  "statement": "A policy whose minimum is P0 passes the same archive: exit 0, passed true, the level unchanged by the policy.",
  "steps": [
    {
      "action": "check",
      "archive": "$archive",
      "policy": {
        "minimum": "P0"
      },
      "expect": {
        "exit": 0,
        "result": {
          "schema": "prism/verdict/1",
          "level": "P0",
          "passed": true,
          "policy": {
            "minimum": "P0"
          }
        }
      }
    }
  ]
}
