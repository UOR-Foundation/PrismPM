{"title":"Shipping Tier","purpose":"Decide the shipping tier for an order from its weight in kilograms and its destination.","fields":[{"name":"weight","kind":"number","min":0,"max":100},{"name":"destination","kind":"choice","values":["domestic","europe","worldwide"]}],"outcomes":["standard","express","premium","invalid"],"rules":[{"when":[{"field":"weight","op":">=","value":10}],"then":"premium"},{"when":[{"field":"destination","op":"is","value":"worldwide"}],"then":"express"},{"when":[{"field":"destination","op":"is","value":"europe"},{"field":"weight","op":">","value":5}],"then":"express"},{"when":[{"field":"destination","op":"is","value":"domestic"},{"field":"weight","op":">","value":2}],"then":"express"}],"otherwise":"standard","properties":[{"kind":"never","when":[{"field":"weight","op":"<","value":0}],"then":"standard"},{"kind":"never","when":[{"field":"weight","op":">","value":100}],"then":"standard"},{"kind":"always","when":[{"field":"weight","op":"=","value":0}],"then":"standard"}]}
